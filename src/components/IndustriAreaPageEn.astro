---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Services from './Services.astro';
import WhyChooseUs from './WhyChooseUs.astro';
import Pricing from './Pricing.astro';
import ProjectSteps from './ProjectSteps.astro';
import CtaBanner from './CtaBanner.astro';
import Footer from './Footer.astro';
import '../styles/global.css';

import en from '../i18n/en.json';
import { getNamaBySlug, type Daerah } from '../data/daerah';
import { getKontenEn } from '../data/daerah-konten-en';
import { industriList, type Industri } from '../data/industri';
import { getKontenIndustriEn } from '../data/industri-konten-en';

export interface Props {
  /** industry data (shared with the ID pages) */
  industri: Industri;
  /** area data (priority area of the industry) */
  daerah: Daerah;
}

const { industri: ind, daerah: d } = Astro.props;
const t = en;
const lang = 'en';

const canonical = `https://zeepage.com/en/website-design-${ind.slugEn}-in-${d.slug}/`;
const idUrl = `https://zeepage.com/jasa-pembuatan-website-${ind.slug}-di-${d.slug}/`;
const alternates = [
  { hreflang: 'id', href: idUrl },
  { hreflang: 'en', href: canonical },
  { hreflang: 'x-default', href: idUrl },
];

const ki = getKontenIndustriEn(ind.slugEn);
const kd = getKontenEn(d.slug);

const title = `Website Design for ${ind.namaEn} in ${d.nama} | zeepage`;
const description = `Website design for ${ind.namaEn.toLowerCase()} in ${d.nama}, Bali with ${ind.fiturEn[0].toLowerCase()} and ${ind.fiturEn[1].toLowerCase()}. From Rp 699k, free consultation.`;

const waText = encodeURIComponent(
  `Hello zeepage, I run a business in ${d.nama}, Bali and I'm interested in a free consultation for website design. Please share more details.`
);
const waUrl = `https://wa.me/6288987244675?text=${waText}`;

// Combined FAQ: 3 from the industry + 2 from the area, deduplicated by question
const faqIndustri = ki?.faq ?? [];
const faqDaerah = kd?.faq ?? [];
const faq = [...faqIndustri.slice(0, 3), ...faqDaerah.filter((f) => !faqIndustri.some((x) => x.q === f.q)).slice(0, 2)];

// Same industry in other priority areas
const areaLain = ind.areaPrioritas
  .filter((s) => s !== d.slug)
  .map((s) => ({ slug: s, nama: getNamaBySlug(s) }));
// Other industries that also serve this area
const industriLain = industriList.filter((x) => x.slug !== ind.slug && x.areaPrioritas.includes(d.slug));

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://zeepage.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://zeepage.com/en/industries/' },
        {
          '@type': 'ListItem',
          position: 3,
          name: ind.namaEn,
          item: `https://zeepage.com/en/website-design-${ind.slugEn}-bali/`,
        },
        { '@type': 'ListItem', position: 4, name: d.nama, item: canonical },
      ],
    },
    {
      '@type': 'Service',
      name: `Website Design for ${ind.namaEn} in ${d.nama}`,
      serviceType: 'Web Development',
      description,
      url: canonical,
      ...(ki?.keywords ? { keywords: ki.keywords.join(', ') } : {}),
      provider: { '@type': 'Organization', name: 'zeepage', url: 'https://zeepage.com/' },
      areaServed: { '@type': 'Place', name: `${d.nama}, Bali` },
    },
    {
      '@type': 'LocalBusiness',
      name: 'zeepage',
      description: `Professional website design services for ${ind.namaEn.toLowerCase()} in ${d.nama}, Bali.`,
      url: canonical,
      image: 'https://zeepage.com/logo.png',
      telephone: '+62 889-8724-4675',
      email: 'zinknot@gmail.com',
      priceRange: 'Rp 699k - Rp 1.499k',
      areaServed: { '@type': 'Place', name: `${d.nama}, Bali` },
      address: { '@type': 'PostalAddress', addressLocality: d.nama, addressRegion: 'Bali', addressCountry: 'ID' },
      parentOrganization: { '@id': 'https://zeepage.com/#organization' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const cta = {
  ...t.cta,
  title: `Ready to Take Your Business in ${d.nama} Online?`,
  subtitle: `Free consultation for ${ind.namaEn.toLowerCase()} in ${d.nama} and beyond. The zeepage team is ready to help from idea to launch.`,
  whatsappUrl: waUrl,
  questions: faq,
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  canonical={canonical}
  alternates={alternates}
  structuredData={structuredData}
  noindex={true}>
  <Navbar
    t={t.nav}
    lang={lang}
    cta={{ primary: t.hero.cta1, secondary: t.hero.cta2, whatsapp: t.cta.whatsapp, whatsappUrl: waUrl }}
  />

  <!-- HERO -->
  <section
    class="relative bg-[#F6F6F3] pt-36 pb-16"
   
  >
    
    
    

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <nav class="flex items-center justify-center gap-2 text-[#1e2547]/50 text-xs font-semibold mb-6" aria-label="Breadcrumb">
        <a href="/en/" class="hover:text-[#0040FF] transition-colors">Home</a>
        <span>/</span>
        <a href="/en/industries/" class="hover:text-[#0040FF] transition-colors">Industries</a>
        <span>/</span>
        <a href={`/en/website-design-${ind.slugEn}-bali/`} class="hover:text-[#0040FF] transition-colors">{ind.namaEn}</a>
        <span>/</span>
        <span class="text-[#1e2547] font-semibold">{d.nama}</span>
      </nav>

      <p class="text-xs sm:text-sm font-bold tracking-[0.22em] uppercase text-[#0040FF] mb-6">Based in Bali · {ind.namaEn} Websites in {d.nama}</p>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#1e2547] leading-tight mb-6">
        Website Design for {ind.namaEn} in {d.nama}, Bali
      </h1>

      <p class="text-[#1e2547]/65 text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
        {ki?.heroLead ?? ind.deskripsiEn}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#0040FF] text-white font-bold px-8 py-3.5 rounded-full shadow-lg hover:bg-[#0020AA] transition-all duration-300"
        >
          Free Consultation
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a
          href="#services"
          class="inline-flex items-center gap-2 border border-[#1e2547]/25 text-[#1e2547] font-bold px-8 py-3.5 rounded-full hover:border-[#1e2547] hover:bg-[#1e2547] hover:text-white transition-all duration-300"
        >
          View Services
        </a>
      </div>
    </div>
  </section>

  <!-- INTRO / SEO CONTENT -->
  <section class="bg-white py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="prose prose-lg max-w-none text-justify">
        <h2 class="text-2xl sm:text-3xl font-black text-[#1e2547] mt-0 mb-4 text-center">
          Why {ind.namaEn} in {d.nama} Need a Professional Website
        </h2>
        {ki?.intro ? (
          <>
            {ki.intro.paragraf.map((p) => (
              <p class="text-gray-600 leading-relaxed">{p}</p>
            ))}
          </>
        ) : (
          <p class="text-gray-600 leading-relaxed">{ind.deskripsiEn}</p>
        )}

        <div class="bg-[#EBEFFF] rounded-2xl p-6 sm:p-8 my-8 border-l-4 border-[#0040FF] not-prose">
          <p class="text-base font-bold text-[#1e2547] mb-2">zeepage tip for {ind.namaEn.toLowerCase()} in {d.nama}:</p>
          <p class="text-sm text-gray-600 leading-relaxed">
            {ki?.intro?.tips ?? `Use industry and location keywords like "${ind.namaEn.toLowerCase()} website design ${d.nama}" in your page titles and descriptions. Also keep your WhatsApp button within easy reach so customers can contact you fast.`}
          </p>
        </div>

        <p class="text-sm text-gray-500 mt-6 not-prose">
          See also: <a href={`/en/website-design-${ind.slugEn}-bali/`} class="text-[#0040FF] font-semibold hover:underline">Website Design for {ind.namaEn} in Bali</a> covering the entire province, or <a href={`/en/website-design-${d.slug}/`} class="text-[#0040FF] font-semibold hover:underline">Website Design Services in {d.nama}</a> for all industries in this area.
        </p>
      </div>
    </div>
  </section>

  <!-- INDUSTRY WEBSITE FEATURES -->
  <section class="bg-[#F6F6F3] py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-[#1e2547] mb-4">Website Features for {ind.namaEn} in {d.nama}</h2>
        <p class="text-[#4f5b7d] text-base sm:text-lg max-w-2xl mx-auto">
          Every website we build for this industry includes features the business actually needs, tuned to the {d.nama} market.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {ind.fiturEn.map((f) => (
          <div class="flex items-start gap-4 bg-white rounded-2xl p-6 border border-[#E3E4DE] shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <span class="w-10 h-10 shrink-0 rounded-xl bg-[#EBEFFF] text-[#0040FF] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <div>
              <h3 class="font-bold text-[#1e2547] mb-1">{f}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">
                {ki?.fiturDesc?.[f] ?? `The ${f.toLowerCase()} feature for your business website in ${d.nama}, making operations easier and customers happier.`}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {kd?.lokal && (
    <section class="bg-white py-16 sm:py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="prose prose-lg max-w-none text-justify">
          <h2 class="text-2xl sm:text-3xl font-black text-[#1e2547] mt-0 mb-4 text-center">{kd.lokal.h2}</h2>
          {kd.lokal.paragraf.map((p) => (
            <p class="text-gray-600 leading-relaxed">{p}</p>
          ))}
        </div>

        <div class="not-prose mt-8">
          <h3 class="text-lg font-bold text-[#1e2547] mb-4">Illustrative Examples</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            {kd.lokal.ilustrasi.map((c) => (
              <div class="bg-[#F6F6F3] rounded-2xl p-6 border border-[#E3E4DE]">
                <h4 class="font-bold text-[#1e2547] mb-2">{c.judul}</h4>
                <p class="text-sm text-gray-600 leading-relaxed">{c.isi}</p>
              </div>
            ))}
          </div>
          <p class="text-xs text-gray-400 italic mt-4">
            {kd.lokal.catatan ?? 'All scenarios above are general illustrations, not specific zeepage clients.'}
          </p>
        </div>
      </div>
    </section>
  )}

  <Services t={t.services} id="services" />
  <WhyChooseUs t={t.why} id="why" />
  <Pricing t={t.pricing} lang={lang} id="pricing" />
  <ProjectSteps t={t.steps} whatsapp={t.cta.whatsapp} id="steps" />

  <!-- SAME INDUSTRY IN OTHER AREAS -->
  {areaLain.length > 0 && (
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-[#1e2547] mb-4">{ind.namaEn} Website Design in Other Areas</h2>
        <p class="text-[#4f5b7d] mb-8">We also serve businesses in this industry across other priority areas in Bali.</p>
        <div class="flex flex-wrap justify-center gap-3">
          {areaLain.map((a) => (
            <a
              href={`/en/website-design-${ind.slugEn}-in-${a.slug}/`}
              class="px-5 py-2.5 rounded-full bg-[#EBEFFF] text-[#0040FF] text-sm font-semibold hover:bg-[#0040FF] hover:text-[#0040FF] transition-colors"
            >
              {ind.namaEn} in {a.nama}
            </a>
          ))}
          <a
            href={`/en/website-design-${ind.slugEn}-bali/`}
            class="px-5 py-2.5 rounded-full bg-[#1e2547] text-white text-sm font-semibold hover:bg-[#0040FF] transition-colors"
          >
            All Areas for {ind.namaEn}
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- OTHER INDUSTRIES IN THIS AREA -->
  {industriLain.length > 0 && (
    <section class="bg-[#F6F6F3] py-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-[#1e2547] mb-4">Website Design for Other Industries in {d.nama}</h2>
        <p class="text-[#4f5b7d] mb-8">Other businesses in {d.nama} can also pick a page dedicated to their industry.</p>
        <div class="flex flex-wrap justify-center gap-3">
          {industriLain.map((x) => (
            <a
              href={`/en/website-design-${x.slugEn}-in-${d.slug}/`}
              class="px-5 py-2.5 rounded-full bg-white border border-[#E3E4DE] text-[#0040FF] text-sm font-semibold hover:bg-[#0040FF] hover:text-[#0040FF] transition-colors"
            >
              {x.namaEn} in {d.nama}
            </a>
          ))}
          <a
            href="/en/industries/"
            class="px-5 py-2.5 rounded-full bg-[#1e2547] text-white text-sm font-semibold hover:bg-[#0040FF] transition-colors"
          >
            View All Industries
          </a>
        </div>
      </div>
    </section>
  )}

  <CtaBanner t={cta} id="contact" />
  <Footer t={t.footer} lang={lang} navLinks={t.nav.links} id="footer" />
</BaseLayout>

<style>
  .hero__grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 60px 60px;
    z-index: 1;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at 50% 50%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 30%, transparent 75%);
  }
  .hero__bg-circle {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }
  .hero__bg-circle--1 {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(0, 80, 255, 0.4) 0%, transparent 70%);
    top: -120px;
    right: -150px;
  }
  .hero__bg-circle--2 {
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(200, 255, 0, 0.08) 0%, transparent 70%);
    bottom: -60px;
    left: -100px;
  }
</style>
