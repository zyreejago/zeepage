---
import SpeedInsights from "@vercel/speed-insights/astro"
import Analytics from '@vercel/analytics/astro'


export interface Props {
  title: string;
  description: string;
  lang: string;
  canonical?: string;
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
  alternates?: { hreflang: string; href: string }[];
  preloadImage?: string;
  image?: string;
}

const { title, description, lang, canonical, structuredData, noindex, alternates, preloadImage, image } = Astro.props;
    const ogImage = image ? (image.startsWith('http') ? image : 'https://zeepage.com' + image) : 'https://zeepage.com/og-image.jpg';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MRR0ECC9SJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MRR0ECC9SJ');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google Tag Manager -->
    <script type="text/javascript">(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5B2JHNL8');</script>
    <!-- End Google Tag Manager -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
    <meta name="theme-color" content="#0040FF" />
    <meta name="author" content="zeepage" />
    <meta name="google-site-verification" content="f_lb5Z5NTRdQA3m7hLSKrwD3KYpVgzWSZFZJABd-jlk" />
    <meta name="msvalidate.01" content="24532BC902817BA356CBEA82249FFE7F" />

    <link rel="preload" href="/fonts/plus-jakarta-sans-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-normal-800-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-italic-500-latin.woff2" as="font" type="font/woff2" crossorigin />

    {canonical && <link rel="canonical" href={canonical} />}
    {alternates
      ? alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)
      : (
        <>
          <link rel="alternate" hreflang="id" href="https://zeepage.com/" />
          <link rel="alternate" hreflang="en" href="https://zeepage.com/en/" />
          <link rel="alternate" hreflang="x-default" href="https://zeepage.com/" />
        </>
      )}

    <meta property="og:site_name" content="zeepage" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'id' ? 'en_US' : 'id_ID'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <style is:global>
      @keyframes hero-line-in {
        from { opacity: 0; transform: translateY(44px); }
        to { opacity: 1; transform: translateY(0); }
      }
      [data-hero-line] {
        animation: hero-line-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: var(--hd, 0.1s);
      }
      @media (prefers-reduced-motion: reduce) {
        [data-hero-line] { animation: none; }
      }
    </style>
  </head>
  <body class="font-sans text-dark bg-[#F6F6F3] antialiased overflow-x-hidden">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5B2JHNL8"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
    <SpeedInsights />
    <Analytics />
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script is:inline>
      (function () {
        if (!window.gsap) return;
        gsap.registerPlugin(ScrollTrigger);
        gsap.fromTo('[data-hero-card]', { y: 60, opacity: 0, rotate: 0 }, { y: 0, opacity: 1, duration: 1, stagger: 0.13, ease: 'power3.out', delay: 0.45, clearProps: 'transform,opacity' });
        gsap.utils.toArray('[data-reveal]').forEach(function (el) {
          gsap.fromTo(el, { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.85, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 86%' } });
        });
        gsap.utils.toArray('[data-reveal-group]').forEach(function (group) {
          gsap.fromTo(group.children, { y: 26, opacity: 0 }, { y: 0, opacity: 1, duration: 0.75, stagger: 0.09, ease: 'power3.out', scrollTrigger: { trigger: group, start: 'top 84%' } });
        });
      })();
    </script>
  </body>
</html>

<script>
// @ts-nocheck
import Lenis from 'lenis'

const lenis = new Lenis({
  autoRaf: true,
})

document.addEventListener('DOMContentLoaded', () => {
  const revealElements = document.querySelectorAll('.reveal');
  if (revealElements.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );
    revealElements.forEach((el) => observer.observe(el));
  }
});
</script>
