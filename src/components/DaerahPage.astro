---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Services from './Services.astro';
import WhyChooseUs from './WhyChooseUs.astro';
import Pricing from './Pricing.astro';
import ProjectSteps from './ProjectSteps.astro';
import CtaBanner from './CtaBanner.astro';
import Footer from './Footer.astro';
import '../styles/global.css';

import id from '../i18n/id.json';
import { getNamaBySlug, areaUrlId, type Daerah } from '../data/daerah';
import { getKonten } from '../data/daerah-konten';
import { industriList } from '../data/industri';

export interface Props {
  /** data daerah yang akan dirender menjadi landing page */
  daerah: Daerah;
}

const { daerah: d } = Astro.props;
const t = id;
const lang = 'id';

const canonical = `https://zeepage.com/jasa-website-${d.slug}/`;
const enUrl = `https://zeepage.com/en/website-design-${d.slug}/`;
const alternates = [
  { hreflang: 'id', href: canonical },
  { hreflang: 'en', href: enUrl },
  { hreflang: 'x-default', href: canonical },
];
const tipeLabel = d.tipe === 'provinsi' ? 'Provinsi' : d.tipe === 'kota' ? 'Kota' : d.tipe === 'kabupaten' ? 'Kabupaten' : 'Kawasan';
const areaSekitar = d.areaSekitar
  .map((s) => ({ slug: s, nama: getNamaBySlug(s) }))
  .filter((a) => a.slug !== d.slug);

const k = getKonten(d.slug);

const title = k?.metaTitle ?? `Jasa Pembuatan Website di ${d.nama} | zeepage`;
const description =
  k?.metaDescription ??
  `Jasa pembuatan website profesional di ${d.nama}, ${d.induk}. Cocok untuk ${d.potensi
    .slice(0, 3)
    .join(', ')
    .toLowerCase()}. Desain modern, SEO-friendly, harga mulai Rp 699k. Konsultasi gratis.`;

const waText = encodeURIComponent(
  `Halo zeepage, saya di ${d.nama} dan tertarik konsultasi gratis pembuatan website untuk bisnis saya. Mohon info lebih lanjut.`
);
const waUrl = `https://wa.me/6288987244675?text=${waText}`;

const faqDefault = [
  {
    q: `Berapa biaya jasa pembuatan website di ${d.nama}?`,
    a: `Paket pembuatan website zeepage di ${d.nama} mulai dari Rp 699k untuk landing page dan Rp 1.499k untuk company profile lengkap dengan domain .com gratis 1 tahun. Harga menyesuaikan kebutuhan fitur, tanpa biaya tersembunyi.`,
  },
  {
    q: `Berapa lama proses pengerjaannya?`,
    a: `Estimasi pengerjaan 1-2 minggu untuk landing page, 2-4 minggu untuk company profile, dan 4-8 minggu untuk e-commerce atau web application. Untuk kebutuhan cepat, tersedia opsi pengerjaan dipercepat.`,
  },
  {
    q: `Apakah zeepage melayani klien di ${d.nama}?`,
    a: `Ya. Meski berbasis di Bali, kami melayani seluruh wilayah ${d.nama} dan sekitarnya secara online maupun tatap muka. Konsultasi, revisi, dan serah terima bisa dilakukan sepenuhnya daring.`,
  },
  {
    q: `Bisakah website saya muncul di Google untuk pencarian lokal ${d.nama}?`,
    a: `Bisa. Kami menerapkan SEO lokal sejak hari pertama: struktur data LocalBusiness, optimasi kata kunci bertema ${d.nama}, kecepatan halaman, dan panduan Google Business Profile agar bisnis Anda mudah ditemukan calon pelanggan setempat.`,
  },
  {
    q: `Jenis website apa yang cocok untuk bisnis di ${d.nama}?`,
    a: `Tergantung model bisnis Anda. ${d.potensi
      .slice(0, 3)
      .join(', ')} umumnya cocok memakai company profile, landing page promosi, atau toko online. Kami bantu merekomendasikan yang paling efisien.`,
  },
];

// FAQ spesifik daerah bila tersedia, jika tidak pakai versi generik
const faq = k?.faq ?? faqDefault;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://zeepage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Area Layanan', item: 'https://zeepage.com/daerah/' },
        { '@type': 'ListItem', position: 3, name: d.nama, item: canonical },
      ],
    },
    {
      '@type': 'Service',
      name: `Jasa Pembuatan Website di ${d.nama}`,
      serviceType: 'Web Development',
      description,
      url: canonical,
      ...(k?.keywords ? { keywords: k.keywords.join(', ') } : {}),
      provider: { '@type': 'Organization', name: 'zeepage', url: 'https://zeepage.com/' },
      areaServed: { '@type': 'Place', name: `${d.nama}, ${d.induk}` },
    },
    {
      '@type': 'LocalBusiness',
      name: 'zeepage',
      description: `Jasa pembuatan website profesional untuk bisnis di ${d.nama}, ${d.induk}.`,
      url: canonical,
      image: 'https://zeepage.com/logo.png',
      telephone: '+62 889-8724-4675',
      email: 'zinknot@gmail.com',
      priceRange: 'Rp 699k - Rp 1.499k',
      areaServed: { '@type': 'Place', name: `${d.nama}, ${d.induk}` },
      address: { '@type': 'PostalAddress', addressLocality: d.nama, addressRegion: 'Bali', addressCountry: 'ID' },
      parentOrganization: { '@id': 'https://zeepage.com/#organization' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const cta = {
  ...t.cta,
  title: `Siap Punya Website di ${d.nama}?`,
  subtitle: `Konsultasi gratis untuk bisnis Anda di ${d.nama}. Tim zeepage siap membantu dari ide hingga website tayang.`,
  whatsappUrl: waUrl,
  questions: faq,
};
---

<BaseLayout title={title} description={description} lang={lang} canonical={canonical} alternates={alternates} structuredData={structuredData} noindex={true}>
  <Navbar
    t={t.nav}
    lang={lang}
    cta={{ primary: t.hero.cta1, secondary: t.hero.cta2, whatsapp: t.cta.whatsapp, whatsappUrl: waUrl }}
  />

  <!-- HERO -->
  <section
    class="relative bg-[#F6F6F3] pt-36 pb-16"
   
  >
    
    
    

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <nav class="flex items-center justify-center gap-2 text-[#1e2547]/50 text-xs font-semibold mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0040FF] transition-colors">Beranda</a>
        <span>/</span>
        <a href="/daerah/" class="hover:text-[#0040FF] transition-colors">Area Layanan</a>
        <span>/</span>
        <span class="text-[#1e2547] font-semibold">{d.nama}</span>
      </nav>

      <p class="text-xs sm:text-sm font-bold tracking-[0.22em] uppercase text-[#0040FF] mb-6">Berbasis di Bali · Melayani {d.nama}</p>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#1e2547] leading-tight mb-6">
        Jasa Pembuatan Website Profesional di {d.nama}
      </h1>

      <p class="text-[#1e2547]/65 text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
        {k?.heroLead ?? `${d.deskripsi} zeepage membangun website cepat, modern, dan SEO-friendly agar bisnis Anda di ${d.nama} mudah ditemukan calon pelanggan.`}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#0040FF] text-white font-bold px-8 py-3.5 rounded-full shadow-lg hover:bg-[#0020AA] transition-all duration-300"
        >
          Konsultasi Gratis
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a
          href="#layanan"
          class="inline-flex items-center gap-2 border border-[#1e2547]/25 text-[#1e2547] font-bold px-8 py-3.5 rounded-full hover:border-[#1e2547] hover:bg-[#1e2547] hover:text-white transition-all duration-300"
        >
          Lihat Layanan
        </a>
      </div>
    </div>
  </section>

  <!-- INTRO / SEO CONTENT -->
  <section class="bg-white py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="prose prose-lg max-w-none text-justify">
      <h2 class="text-2xl sm:text-3xl font-black text-[#1e2547] mt-0 mb-4 text-center">
        {k?.intro?.h2 ?? `Kenapa Bisnis di ${d.nama} Butuh Website Profesional?`}
      </h2>
      {k?.intro ? (
        <>
          {k.intro.paragraf.map((p) => (
            <p class="text-gray-600 leading-relaxed">{p}</p>
          ))}
        </>
      ) : (
        <>
          <p class="text-gray-600 leading-relaxed">
            {d.nama} merupakan {tipeLabel.toLowerCase()} di {d.induk} dengan denyut ekonomi yang terus tumbuh. Mulai dari
            <strong>{d.potensi.join(', ')}</strong>, hampir semua pelaku usaha kini bersaing di ranah digital. Calon pelanggan
            di {d.nama} terbiasa mencari informasi lewat Google sebelum memutuskan membeli atau berkunjung.
          </p>
          <p class="text-gray-600 leading-relaxed">
            Tanpa website yang rapi dan mudah ditemukan, bisnis Anda berisiko kehilangan calon pelanggan ke kompetitor yang
            tampil lebih dulu di hasil pencarian. zeepage membantu UMKM hingga perusahaan di {d.nama} memiliki website yang
            cepat, responsif, dan dioptimalkan untuk SEO lokal, sehingga bisnis Anda muncul saat orang mencari produk atau
            jasa di sekitar {d.nama}.
          </p>
          <p class="text-gray-600 leading-relaxed">
            Beberapa ikon kawasan {d.nama} seperti {d.landmark.join(', ')} menjadi magnet kunjungan. Manfaatkan momen itu
            dengan website yang siap menerima order, booking, dan pertanyaan pelanggan selama 24 jam.
          </p>
        </>
      )}

      <div class="bg-[#EBEFFF] rounded-2xl p-6 sm:p-8 my-8 border-l-4 border-[#0040FF] not-prose">
        <p class="text-base font-bold text-[#1e2547] mb-2">Tips dari zeepage untuk bisnis di {d.nama}:</p>
        <p class="text-sm text-gray-600 leading-relaxed">
          {k?.intro?.tips ?? `Gunakan kata kunci bertema lokasi seperti "jasa ${d.potensi[0].toLowerCase()} ${d.nama}" pada judul halaman dan deskripsi. Pastikan juga alamat serta nomor WhatsApp Anda tercantum jelas agar pelanggan lokal cepat menghubungi.`}
        </p>
      </div>

      {d.slug !== 'bali' && (
        <p class="text-sm text-gray-500 mt-6 not-prose">
          Lihat juga: <a href="/jasa-website-bali/" class="text-[#0040FF] font-semibold hover:underline">Jasa Pembuatan Website di Bali</a> untuk cakupan seluruh provinsi.
        </p>
      )}
      </div>
    </div>
  </section>

  <!-- INDUSTRI YANG DILAYANI -->
  <section class="bg-[#F6F6F3] py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-[#1e2547] mb-4">Industri yang Kami Layani di {d.nama}</h2>
        <p class="text-[#4f5b7d] text-base sm:text-lg max-w-2xl mx-auto">
          Kami memahami karakter bisnis di {d.nama} dan merancang website yang sesuai dengan kebutuhan industri Anda.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {d.potensi.map((p) => (
          <div class="flex items-start gap-4 bg-white rounded-2xl p-6 border border-[#E3E4DE] shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <span class="w-10 h-10 shrink-0 rounded-xl bg-[#EBEFFF] text-[#0040FF] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <div>
              <h3 class="font-bold text-[#1e2547] mb-1">{p}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">
                {k?.potensiDesc?.[p] ?? `Website profesional untuk usaha ${p.toLowerCase()} di ${d.nama} agar lebih dipercaya dan mudah ditemukan.`}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {k?.lokal && (
    <section class="bg-white py-16 sm:py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="prose prose-lg max-w-none text-justify">
          <h2 class="text-2xl sm:text-3xl font-black text-[#1e2547] mt-0 mb-4 text-center">{k.lokal.h2}</h2>
          {k.lokal.paragraf.map((p) => (
            <p class="text-gray-600 leading-relaxed">{p}</p>
          ))}
        </div>

        <div class="not-prose mt-8">
          <h3 class="text-lg font-bold text-[#1e2547] mb-4">Contoh Ilustratif Pemanfaatan Website</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            {k.lokal.ilustrasi.map((c) => (
              <div class="bg-[#F6F6F3] rounded-2xl p-6 border border-[#E3E4DE]">
                <h4 class="font-bold text-[#1e2547] mb-2">{c.judul}</h4>
                <p class="text-sm text-gray-600 leading-relaxed">{c.isi}</p>
              </div>
            ))}
          </div>
          <p class="text-xs text-gray-400 italic mt-4">
            {k.lokal.catatan ?? 'Semua skenario di atas adalah ilustrasi umum, bukan klien spesifik zeepage.'}
          </p>
        </div>
      </div>
    </section>
  )}

  <Services t={t.services} id="layanan" />
  <WhyChooseUs t={t.why} id="kenapa" />
  <Pricing t={t.pricing} lang={lang} id="harga" />
  <ProjectSteps t={t.steps} whatsapp={t.cta.whatsapp} id="langkah" />

  <!-- AREA SEKITAR -->
  {areaSekitar.length > 0 && (
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-[#1e2547] mb-4">Kami Juga Melayani Area di Sekitar {d.nama}</h2>
        <p class="text-[#4f5b7d] mb-8">zeepage melayani pembuatan website untuk bisnis di berbagai kawasan Bali dan sekitarnya.</p>
        <div class="flex flex-wrap justify-center gap-3">
          {areaSekitar.map((a) => (
            <a
              href={areaUrlId(a.slug)}
              class="px-5 py-2.5 rounded-full bg-[#EBEFFF] text-[#0040FF] text-sm font-semibold hover:bg-[#0040FF] hover:text-[#0040FF] transition-colors"
            >
              Jasa Website {a.nama}
            </a>
          ))}
          <a
            href="/daerah/"
            class="px-5 py-2.5 rounded-full bg-[#1e2547] text-white text-sm font-semibold hover:bg-[#0040FF] transition-colors"
          >
            Lihat Semua Area
          </a>
        </div>
      </div>
    </section>
  )}

  {d.slug === 'bali' && (
    <section class="bg-[#F6F6F3] py-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-[#1e2547] mb-4">Jasa Pembuatan Website Berdasarkan Industri</h2>
        <p class="text-[#4f5b7d] mb-8">Setiap industri di Bali punya kebutuhan website yang berbeda. Lihat halaman khusus untuk industri Anda.</p>
        <div class="flex flex-wrap justify-center gap-3">
          {industriList.map((x) => (
            <a
              href={`/jasa-pembuatan-website-${x.slug}/`}
              class="px-5 py-2.5 rounded-full bg-white border border-[#E3E4DE] text-[#0040FF] text-sm font-semibold hover:bg-[#0040FF] hover:text-[#0040FF] transition-colors"
            >
              Website {x.nama}
            </a>
          ))}
          <a
            href="/industri/"
            class="px-5 py-2.5 rounded-full bg-[#1e2547] text-white text-sm font-semibold hover:bg-[#0040FF] transition-colors"
          >
            Lihat Semua Industri
          </a>
        </div>
      </div>
    </section>
  )}

  {d.slug !== 'bali' && industriList.some((x) => x.areaPrioritas.includes(d.slug)) && (
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-[#1e2547] mb-4">Jasa Pembuatan Website per Industri di {d.nama}</h2>
        <p class="text-[#4f5b7d] mb-8">Pilih industri bisnis Anda untuk melihat layanan website khusus di {d.nama}.</p>
        <div class="flex flex-wrap justify-center gap-3">
          {industriList.filter((x) => x.areaPrioritas.includes(d.slug)).map((x) => (
            <a
              href={`/jasa-pembuatan-website-${x.slug}-di-${d.slug}/`}
              class="px-5 py-2.5 rounded-full bg-[#EBEFFF] text-[#0040FF] text-sm font-semibold hover:bg-[#0040FF] hover:text-[#0040FF] transition-colors"
            >
              Website {x.nama} di {d.nama}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBanner t={cta} id="kontak" />
  <Footer t={t.footer} lang={lang} navLinks={t.nav.links} id="footer" />
</BaseLayout>

<style>
  .hero__grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 60px 60px;
    z-index: 1;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at 50% 50%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 30%, transparent 75%);
  }
  .hero__bg-circle {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }
  .hero__bg-circle--1 {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(0, 80, 255, 0.4) 0%, transparent 70%);
    top: -120px;
    right: -150px;
  }
  .hero__bg-circle--2 {
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(200, 255, 0, 0.08) 0%, transparent 70%);
    bottom: -60px;
    left: -100px;
  }
</style>
