---
export interface Props {
  lang: 'id' | 'en';
}

const { lang } = Astro.props;

const content = lang === 'id' ? {
  eyebrow: 'zeepage',
  title: 'Bikin Website',
  accent: 'Profesional?',
  price: 'Mulai Rp 799rb',
  points: ['Desain custom, bukan template pasaran', 'SEO friendly dan fast loading', 'Gratis konsultasi, tanpa komitmen'],
  cta: 'Konsultasi Gratis via WA',
  note: 'Respon cepat pada jam kerja',
  waText: 'Halo%20zeepage%2C%20saya%20tertarik%20membuat%20website.%20Mohon%20info%20lebih%20lanjut.',
} : {
  eyebrow: 'zeepage',
  title: 'Need a',
  accent: 'Professional Website?',
  price: 'From Rp 799k',
  points: ['Custom design, no generic templates', 'SEO friendly and fast loading', 'Free consultation, no commitment'],
  cta: 'Free Consultation via WA',
  note: 'Fast replies during working hours',
  waText: 'Hello%20zeepage%2C%20I%27m%20interested%20in%20building%20a%20website.%20Please%20provide%20more%20information.',
};
---

<div class="hidden md:block w-[260px] lg:w-[320px] shrink-0">
  <div class="sticky top-28">
    <div class="bg-[#1e2547] rounded-3xl p-5 lg:p-7 text-white shadow-xl shadow-[#1e2547]/20 overflow-hidden">
      <div class="flex items-center gap-2.5 mb-6">
        <img src="/logo-ui.webp" alt="zeepage" class="h-9 w-auto" width="36" height="36" />
        <span class="text-xs font-bold tracking-[0.22em] uppercase text-white/60">{content.eyebrow}</span>
      </div>
      <h3 class="font-extrabold text-[1.35rem] lg:text-[1.7rem] leading-[1.12] tracking-tight">
        {content.title} <em class="font-display italic font-medium text-[#9db8ff]">{content.accent}</em>
      </h3>
      <p class="font-display italic text-xl text-white/85 mt-4">{content.price}</p>
      <ul class="space-y-2.5 mt-5 text-sm text-white/75">
        {content.points.map((point) => (
          <li class="flex items-start gap-2.5">
            <span class="w-5 h-5 bg-[#0040FF] rounded-full flex items-center justify-center shrink-0 mt-px">
              <svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span>{point}</span>
          </li>
        ))}
      </ul>
      <a
        href={`https://wa.me/6288987244675?text=${content.waText}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full bg-[#0040FF] text-white font-bold text-sm px-5 py-3.5 rounded-full hover:bg-[#0020AA] transition-colors mt-7"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        {content.cta}
      </a>
      <p class="text-[11px] text-white/40 text-center mt-3.5">{content.note}</p>
    </div>
  </div>
</div>
