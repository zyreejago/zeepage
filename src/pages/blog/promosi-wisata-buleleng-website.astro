            <a href="/jasa-pembuatan-website-di-buleleng/" class="border border-white/40 rounded-full px-7 py-3.5 font-bold">Lihat Jasa Pembuatan Website di Buleleng</a>
          </div>
        </div>
      </div>
    </article>
  </main>
  <Footer t={t.footer} lang={lang} navLinks={t.nav.links} id="footer" />
</BaseLayout>
