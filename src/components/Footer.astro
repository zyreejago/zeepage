---
export interface Props {
  t: {
    description: string;
    menuTitle: string;
    menu: { label: string; href: string }[];
    servicesTitle: string;
    services: string[];
    contactTitle: string;
    contact: { email: string; whatsapp: string; location: string };
    copyright: string;
  };
  navLinks?: { label: string; href: string }[];
  lang: string;
  id: string;
}

const { t, navLinks, lang, id } = Astro.props;
const isId = lang === 'id';
const footerMenu = navLinks ?? t.menu;
const waDigits = t.contact.whatsapp.replace(/\D/g, '').replace(/^0/, '62');
const backTop = isId ? 'Kembali ke atas' : 'Back to top';
---

<!-- Elfsight Instagram Feed -->
<section class="bg-paper py-14" aria-label="Instagram zeepage">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <script is:inline src="https://elfsightcdn.com/platform.js" async></script>
    <div class="elfsight-app-febd2f44-6722-48f5-8ce6-7f4086f55376" data-elfsight-app-lazy></div>
  </div>
</section>

<footer id={id} class="bg-ink text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-10">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5 mb-4">
          <img src="/logo-ui.webp" alt="zeepage" class="w-10 h-10 rounded-full object-cover" width="40" height="40" />
          <span class="font-extrabold text-xl">zeepage</span>
        </div>
        <p class="text-white/60 text-sm leading-relaxed">{t.description}</p>
      </div>
      <nav class="flex flex-col gap-2.5 text-sm font-semibold text-white/70" aria-label="Footer">
        {footerMenu.map((link) => (
          <a href={link.href} class="hover:text-white transition-colors">{link.label}</a>
        ))}
      </nav>
      <div class="flex flex-col gap-2.5 text-sm font-semibold text-white/70">
        <a href={`https://wa.me/${waDigits}`} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">WhatsApp {t.contact.whatsapp}</a>
        <a href="https://instagram.com/zeecreate.id" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Instagram @zeecreate.id</a>
        <span class="text-white/50">{t.contact.location}</span>
      </div>
    </div>
    <div class="border-t border-white/10 mt-10 pt-6 flex flex-col sm:flex-row justify-between gap-3 text-xs text-white/40">
      <p>{t.copyright}</p>
      <a href="#top" class="hover:text-white transition-colors">{backTop}</a>
    </div>
  </div>
</footer>

<a
  href={`https://wa.me/${waDigits}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat WhatsApp"
  class="wa-float fixed bottom-5 right-5 z-[60] w-14 h-14 rounded-full bg-[#25D366] shadow-xl shadow-ink/25 flex items-center justify-center hover:scale-110 active:scale-95 transition-transform"
>
  <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
</a>

<style>
  @keyframes wa-in {
    from { opacity: 0; transform: translateY(16px) scale(0.8); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .wa-float { animation: wa-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.8s backwards; }
</style>
