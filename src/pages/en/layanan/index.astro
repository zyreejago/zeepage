---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import Pricing from '../../../components/Pricing.astro';
import ComparisonSection from '../../../components/ComparisonSection.astro';
import ContactCta from '../../../components/ContactCta.astro';
import '../../../styles/global.css';

import en from '../../../i18n/en.json';
import { content, WA_EN } from '../../../data/home-content';
import { daerahList } from '../../../data/daerah';

const t = en;
const lang = 'en';
const canonical = 'https://zeepage.com/en/layanan/';
const c = content.en;
const pricingT = {
  ...t.pricing,
  badge: 'Pricing',
  title: 'Website Pricing Packages',
  titleHighlight: 'for Small Businesses',
  subtitle: 'Every package includes a free .com domain for 1 year, free hosting, free SSL, and free support. No hidden fees.',
};

const tokoOnline = {
  name: 'Online Store Website',
  was: 'Rp 3,500,000',
  price: 'Rp 2,500,000',
  target: 'For businesses that want to sell online with a product catalog, shopping cart, and automated ordering.',
  features: [
    'Free .com Domain',
    'Free Hosting',
    'Free SSL (Security)',
    'Free Support',
    'Free Maintenance',
    'Responsive Website',
    'Shopping Cart',
    'Online / WhatsApp Ordering',
    'Automatic Shipping Calculation',
    'Annual Fee Rp 1,200,000',
  ],
  whatsapp: 'https://wa.me/6288987244675?text=Hello%20zeepage%2C%20I%20am%20interested%20in%20the%20Online%20Store%20Website%20package%20at%20Rp%202%2C500%2C000.%20Please%20send%20more%20details.',
};


const h2s = [
  'Landing Page Design Service',
  'Company Profile Website Service',
  'Online Store Website Service',
  'Web Application Development Service',
  'Website Redesign and Maintenance Service',
];
---

<BaseLayout
  title="Website Design Services in Bali | zeepage"
  description="Website design services in Bali by zeepage: landing pages from Rp 799k, company profiles, online stores, web applications, redesign and maintenance. Free consultation."
  lang="en"
  canonical={canonical}
>
  <Navbar t={t.nav} lang={lang} cta={{ primary: t.hero.cta1, secondary: t.hero.cta2, whatsapp: t.cta.whatsapp, whatsappUrl: t.cta.whatsappUrl }} />

  <main>
    <section class="relative pt-32 sm:pt-40 pb-16 sm:pb-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <p class="text-sm font-bold text-brand mb-3" data-reveal>Services</p>
        <h1 class="text-5xl sm:text-6xl font-extrabold tracking-tight max-w-4xl" data-reveal>
          Website design services <em class="font-display italic font-medium text-brand">in Bali.</em>
        </h1>
        <p class="text-ink/60 text-lg leading-relaxed max-w-2xl mt-6" data-reveal>
          {c.services.note} Every package is built directly by the zeepage team, with no middlemen, and starts with a free consultation so the package fits your goals.
        </p>
      </div>
    </section>

    <section class="pb-16 sm:pb-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid gap-6">
          {c.services.rows.map((r: any, i: number) => (
            <article class="bg-white border border-line rounded-3xl p-7 sm:p-9" data-reveal>
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="max-w-2xl">
                  <p class="font-display italic text-brand/70 text-lg mb-2">{String(i + 1).padStart(2, '0')}</p>
                  <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{h2s[i]}</h2>
                  <p class="text-ink/60 leading-relaxed mt-4">{r.desc}</p>
                  <p class="text-xs font-semibold tracking-wide uppercase text-ink/40 mt-4">{r.meta}</p>
                </div>
                <div class="text-left sm:text-right shrink-0">
                  <p class="font-display italic text-xl sm:text-2xl text-brand">{r.price}</p>
                  <a href={WA_EN} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-4 bg-brand text-white text-sm font-bold px-5 py-2.5 rounded-full hover:bg-branddark transition-colors">Ask About This Package</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-20 bg-white border-y border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight" data-reveal>Website design service areas</h2>
        <p class="text-ink/55 leading-relaxed max-w-2xl mt-4" data-reveal>We are based in Bali and build websites for businesses across the regencies, cities, and areas below. Outside Bali, all work runs online for clients across Indonesia.</p>
        <ul data-reveal-group class="flex flex-wrap gap-2.5 mt-8">
          {daerahList.filter((d) => d.tipe !== 'provinsi').map((d) => (
            <li class="px-4 py-2 rounded-full border border-line bg-paper text-sm font-semibold text-ink/75">{d.nama}</li>
          ))}
        </ul>
      </div>
    </section>

    <Pricing t={pricingT} lang={lang} id="paket" />

    <section class="py-16 sm:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="mb-10" data-reveal>
          <p class="text-sm font-bold text-brand mb-2">Online Store</p>
          <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight">
            Online store website price <em class="font-display italic font-medium text-brand">for selling online.</em>
          </h2>
          <p class="text-ink/55 max-w-xl text-sm sm:text-base leading-relaxed mt-4">One complete package to start selling online: a product catalog, shopping cart, WhatsApp ordering, and automatic shipping cost calculation.</p>
        </div>

        <article class="relative rounded-3xl bg-ink text-white p-7 sm:p-10 shadow-2xl" data-reveal>
          <span class="absolute -top-3 left-7 bg-brand text-white text-[11px] font-bold tracking-wider uppercase px-3 py-1 rounded-full">Promo</span>
          <div class="grid md:grid-cols-2 gap-8 md:gap-12">
            <div class="flex flex-col">
              <h3 class="font-bold text-lg">{tokoOnline.name}</h3>
              <p class="mt-4 text-white/50 line-through text-2xl font-bold">{tokoOnline.was}</p>
              <p class="font-extrabold tracking-tight text-5xl mt-1">{tokoOnline.price}</p>
              <p class="text-sm mt-3 text-white/70 leading-relaxed">{tokoOnline.target}</p>
              <a href={tokoOnline.whatsapp} target="_blank" rel="noopener noreferrer" class="mt-auto pt-8">
                <span class="inline-flex justify-center w-full sm:w-auto bg-brand text-white font-bold px-8 py-3.5 rounded-full hover:bg-branddark transition-colors">Choose the Online Store Package</span>
              </a>
            </div>
            <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-3.5 text-sm content-start">
              {tokoOnline.features.map((f) => (
                <li class="flex items-start gap-2.5">
                  <svg class="w-5 h-5 mt-0.5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      </div>
    </section>

    <ComparisonSection t={content.en} />

<ContactCta lang="en" heading="Not sure which" accent="package fits?" sub="Just tell us what your business needs. We will help you pick the right type of website and package, free and with no commitment." />
  </main>

  <Footer t={t.footer} lang={lang} navLinks={t.nav.links} id="footer" />
</BaseLayout>
