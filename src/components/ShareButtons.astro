---
interface Props {
  title: string;
  url: string;
  lang: string;
  extraClass?: string;
}
const { title, url, lang, extraClass = '' } = Astro.props;
const isId = lang === 'id';
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const full = encodeURIComponent(title + ' ' + url);

const btn =
  'w-11 h-11 grid place-items-center rounded-full border border-line bg-white text-ink/60 hover:text-brand hover:border-brand/50 transition';

const links = [
  {
    label: 'WhatsApp',
    href: `https://wa.me/?text=${full}`,
    path: 'M12.04 2a9.9 9.9 0 0 0-8.5 15.2L2.1 22l4.9-1.4A9.9 9.9 0 1 0 12.04 2zm0 18.1a8.1 8.1 0 0 1-4.2-1.15l-.3-.18-3.03.8.81-2.95-.2-.3a8.1 8.1 0 1 1 6.92 3.78zm4.5-6c-.25-.13-1.48-.73-1.71-.81-.23-.09-.4-.13-.56.12-.17.25-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.48-.4-.41-.56-.42h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.1 0 1.24.9 2.44 1.03 2.61.12.17 1.77 2.7 4.3 3.79.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.48-.6 1.7-1.26.21-.66.21-1.22.14-1.34-.06-.12-.22-.18-.47-.31z',
  },
  {
    label: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    path: 'M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.5h-2.6C11.8 2.5 11 4.3 11 6.5v2H8.5V12H11v9.5h3V12h2.6l.4-3.5h-3V8.5z',
  },
  {
    label: 'X',
    href: `https://twitter.com/intent/tweet?url=${u}&text=${t}`,
    path: 'M17.8 3h3l-6.7 7.7L22 21h-6.2l-4.8-6.3L5.4 21h-3l7.2-8.2L2 3h6.4l4.4 5.8L17.8 3zm-1.1 16.1h1.7L7.4 4.8H5.6l11.1 14.3z',
  },
  {
    label: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
    path: 'M4.98 3.5C4.98 4.88 3.87 6 2.5 6S.02 4.88.02 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.31h4.52V23H.24V8.31zM8.34 8.31h4.33v2h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.92V23h-4.52v-7.1c0-1.7-.03-3.88-2.37-3.88-2.37 0-2.73 1.85-2.73 3.76V23H8.34V8.31z',
  },
  {
    label: 'Telegram',
    href: `https://t.me/share/url?url=${u}&text=${t}`,
    path: 'M9.04 15.9l-.38 5.36c.55 0 .79-.24 1.08-.53l2.6-2.48 5.38 3.94c.99.55 1.69.26 1.95-.91L22.9 4.6c.32-1.45-.52-2.02-1.48-1.66L2.4 9.6c-1.42.55-1.4 1.34-.24 1.7l4.85 1.51L18.27 6.1c.53-.35 1.01-.16.61.19L9.04 15.9z',
  },
];
---

<div class={`flex flex-wrap items-center gap-2.5 ${extraClass}`} data-share-row>
  <span class="text-sm font-bold text-ink/45 mr-1">{isId ? 'Bagikan:' : 'Share:'}</span>
  {
    links.map((l) => (
      <a
        href={l.href}
        target="_blank"
        rel="noopener"
        aria-label={(isId ? 'Bagikan ke ' : 'Share on ') + l.label}
        title={l.label}
        class={btn}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={l.path} />
        </svg>
      </a>
    ))
  }
  <a
    href="https://www.instagram.com/zeepagecom"
    target="_blank"
    rel="noopener"
    aria-label="Instagram zeepage"
    title="Instagram"
    class={btn}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" stroke="none" />
    </svg>
  </a>
  <button
    type="button"
    data-copy-link
    data-url={url}
    aria-label={isId ? 'Salin tautan artikel' : 'Copy article link'}
    title={isId ? 'Salin tautan' : 'Copy link'}
    class={btn}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
    </svg>
  </button>
  <span data-copy-msg class="text-sm font-semibold text-brand hidden">{isId ? 'Tautan disalin' : 'Link copied'}</span>
</div>

<script>
  document.querySelectorAll('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.getAttribute('data-url') || location.href);
      } catch (e) {}
      const row = btn.closest('[data-share-row]');
      const msg = row && row.querySelector('[data-copy-msg]');
      if (msg) {
        msg.classList.remove('hidden');
        setTimeout(() => msg.classList.add('hidden'), 1800);
      }
    });
  });
</script>
