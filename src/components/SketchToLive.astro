<script>
  document.querySelectorAll('[data-zcs-toggle]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var fig = btn.closest('figure');
      var stage = fig ? fig.querySelector('[data-zcs-stage]') : null;
      if (!stage) return;
      var paused = stage.classList.toggle('zcs-paused');
      btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
      var label = btn.querySelector('[data-zcs-toggle-label]');
      if (label) label.textContent = paused ? 'Putar' : 'Jeda';
      var ip = btn.querySelector('[data-zcs-icon-pause]');
      var il = btn.querySelector('[data-zcs-icon-play]');
      if (ip) ip.hidden = paused;
      if (il) il.hidden = !paused;
    });
  });
</script>

