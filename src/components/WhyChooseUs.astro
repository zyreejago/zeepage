---
export interface Props {
  t: {
    badge: string;
    title: string;
    titleHighlight: string;
    subtitle: string;
    withLabel: string;
    withoutLabel: string;
    with: string[];
    without: string[];
  };
  id: string;
}

const { t, id } = Astro.props;
---

<section id={id} class="bg-paper border-y border-line pt-16 pb-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center flex flex-col items-center mb-6">
      <div class="inline-flex items-center gap-2 bg-[#eef2ff] text-[#0040FF] text-[11px] font-bold tracking-widest uppercase px-4 py-1.5 rounded-full mb-5 mx-auto">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0040FF]"></span>
        {t.badge}
      </div>
      <h2 class="text-4xl md:text-5xl font-black text-[#1e2547] leading-[1.1] tracking-tight text-center">
        {t.title}<br />
        <span class="text-[#0040FF]">{t.titleHighlight}</span>
      </h2>
      <p class="text-[#4f5b7d] text-base md:text-lg leading-relaxed max-w-xl mx-auto text-center mt-5">{t.subtitle}</p>
    </div>

    <!-- Toggle Tabs -->
    <div class="flex bg-gray-100 rounded-full p-1 w-fit mx-auto mt-8 mb-12">
      <button id="tab-with" class="px-6 py-2 rounded-full text-sm font-semibold transition-all bg-[#0040FF] text-white shadow-sm">
        {t.withLabel}
      </button>
      <button id="tab-without" class="px-6 py-2 rounded-full text-sm font-semibold transition-all text-[#6b7280]">
        {t.withoutLabel}
      </button>
    </div>

    <!-- Mobile: Vertical Hub -->
    <div class="flex flex-col items-center w-full md:hidden px-6">
      <div class="flex flex-col items-start gap-3 w-full max-w-[300px] mx-auto mb-4">
        {t.with.map((item) => (
          <div class="spoke-right spoke-item right flex items-center gap-3 bg-white border border-gray-200 shadow-md rounded-2xl px-5 py-3 w-full">
            <span class="w-5 h-5 shrink-0 flex items-center justify-center bg-[#84CC16] rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6l3 3 5-5"/></svg>
            </span>
            <span class="text-[14px] font-semibold text-[#1e2547] text-left">{item}</span>
          </div>
        ))}
      </div>

      <svg class="mx-auto" style="width: 2px; height: 40px; overflow: visible;" viewBox="0 0 2 40">
        <line class="spoke-line" x1="1" y1="0" x2="1" y2="40" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
      </svg>

      <div class="relative flex items-center justify-center my-2">
        <div class="hub-ring"></div>
        <div class="hub-ring"></div>
        <div class="hub-ring"></div>
        <div class="hub-circle w-16 h-16 rounded-full bg-[#0040FF] flex items-center justify-center text-white font-black text-xl shadow-lg shadow-[#0040FF]/30 z-10">
          Z
        </div>
      </div>

      <svg class="mx-auto" style="width: 2px; height: 40px; overflow: visible;" viewBox="0 0 2 40">
        <line class="spoke-line" x1="1" y1="0" x2="1" y2="40" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
      </svg>

      <div class="flex flex-col items-start gap-3 w-full max-w-[300px] mx-auto mt-4">
        {t.without.map((item) => (
          <div class="spoke-left spoke-item flex items-center gap-3 bg-white border border-gray-200 shadow-sm rounded-2xl px-5 py-3 w-full opacity-30">
            <span class="w-5 h-5 shrink-0 flex items-center justify-center bg-red-400 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l6 6M9 3l-6 6"/></svg>
            </span>
            <span class="text-[14px] text-[#6B7280] text-left">{item}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Desktop: Hub-and-Spoke -->
    <div class="hidden md:grid grid-cols-[1fr_auto_1fr] items-center gap-8 max-w-4xl mx-auto relative">
      <svg class="absolute inset-0 w-full h-full pointer-events-none z-0 spoke-lines" viewBox="0 0 800 400" preserveAspectRatio="xMidYMid meet">
        <line class="spoke-line" x1="320" y1="50" x2="400" y2="200" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
        <line class="spoke-line" x1="320" y1="130" x2="400" y2="200" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
        <line class="spoke-line" x1="320" y1="210" x2="400" y2="200" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
        <line class="spoke-line" x1="320" y1="290" x2="400" y2="200" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
        <line class="spoke-line" x1="320" y1="370" x2="400" y2="200" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
        <line class="spoke-line" x1="480" y1="50" x2="400" y2="200" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
        <line class="spoke-line" x1="480" y1="130" x2="400" y2="200" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
        <line class="spoke-line" x1="480" y1="210" x2="400" y2="200" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
        <line class="spoke-line" x1="480" y1="290" x2="400" y2="200" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
        <line class="spoke-line" x1="480" y1="370" x2="400" y2="200" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="6 4" />
      </svg>

      <div class="flex flex-col gap-4 items-end relative z-10">
        {t.without.map((item) => (
          <div class="spoke-left spoke-item flex items-center gap-3 bg-white border border-gray-200 shadow-sm rounded-xl px-4 py-2.5 text-sm font-medium text-[#6B7280] opacity-30">
            <span class="w-5 h-5 shrink-0 flex items-center justify-center bg-red-400 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l6 6M9 3l-6 6"/></svg>
            </span>
            <span>{item}</span>
          </div>
        ))}
      </div>

      <div class="relative flex items-center justify-center">
        <div class="hub-ring"></div>
        <div class="hub-ring"></div>
        <div class="hub-ring"></div>
        <div class="hub-circle w-20 h-20 rounded-full bg-[#0040FF] flex items-center justify-center text-white font-black text-2xl shadow-xl shadow-[#0040FF]/30 z-10 shrink-0">
          Z
        </div>
      </div>

      <div class="flex flex-col gap-4 items-start relative z-10">
        {t.with.map((item) => (
          <div class="spoke-right spoke-item right flex items-center gap-3 bg-white border border-gray-200 shadow-md rounded-xl px-4 py-2.5 text-sm font-medium text-[#1e2547]">
            <span class="w-5 h-5 shrink-0 flex items-center justify-center bg-[#84CC16] rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6l3 3 5-5"/></svg>
            </span>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes breathe {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(33, 82, 207, 0.4), 0 6px 20px rgba(33, 82, 207, 0.3);
    }
    50% {
      box-shadow: 0 0 0 16px rgba(33, 82, 207, 0), 0 6px 20px rgba(33, 82, 207, 0.3);
    }
  }

  .hub-circle {
    animation: breathe 2.4s ease-in-out infinite;
  }

  @keyframes march {
    to { stroke-dashoffset: -20; }
  }

  .spoke-line {
    stroke-dasharray: 6 4;
    stroke-dashoffset: 0;
    animation: march 1.2s linear infinite;
  }

  @keyframes ripple {
    0% { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  .hub-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(33, 82, 207, 0.4);
    animation: ripple 2s ease-out infinite;
    pointer-events: none;
  }

  .hub-ring:nth-child(2) { animation-delay: 0.6s; }
  .hub-ring:nth-child(3) { animation-delay: 1.2s; }

  @keyframes fadeSlideIn {
    from { transform: translateX(-12px); }
    to { transform: translateX(0); }
  }

  @keyframes fadeSlideInRight {
    from { transform: translateX(12px); }
    to { transform: translateX(0); }
  }

  .spoke-item {
    animation: fadeSlideIn 0.5s ease forwards;
  }

  .spoke-item:nth-child(1) { animation-delay: 0.1s; }
  .spoke-item:nth-child(2) { animation-delay: 0.2s; }
  .spoke-item:nth-child(3) { animation-delay: 0.3s; }
  .spoke-item:nth-child(4) { animation-delay: 0.4s; }
  .spoke-item:nth-child(5) { animation-delay: 0.5s; }

  .spoke-item.right {
    animation-name: fadeSlideInRight;
  }

  .spoke-item.right:nth-child(1) { animation-delay: 0.15s; }
  .spoke-item.right:nth-child(2) { animation-delay: 0.25s; }
  .spoke-item.right:nth-child(3) { animation-delay: 0.35s; }
  .spoke-item.right:nth-child(4) { animation-delay: 0.45s; }
  .spoke-item.right:nth-child(5) { animation-delay: 0.55s; }
</style>

<script>
// @ts-nocheck
const tabWith = document.getElementById('tab-with');
const tabWithout = document.getElementById('tab-without');
const leftItems = document.querySelectorAll('.spoke-left');
const rightItems = document.querySelectorAll('.spoke-right');

tabWith.addEventListener('click', () => {
  tabWith.classList.add('bg-[#0040FF]', 'text-white', 'shadow-sm');
  tabWith.classList.remove('text-[#6b7280]');
  tabWithout.classList.remove('bg-[#0040FF]', 'text-white', 'shadow-sm');
  tabWithout.classList.add('text-[#6b7280]');
  leftItems.forEach(el => el.classList.add('opacity-30'));
  rightItems.forEach(el => el.classList.remove('opacity-30'));
});

tabWithout.addEventListener('click', () => {
  tabWithout.classList.add('bg-[#0040FF]', 'text-white', 'shadow-sm');
  tabWithout.classList.remove('text-[#6b7280]');
  tabWith.classList.remove('bg-[#0040FF]', 'text-white', 'shadow-sm');
  tabWith.classList.add('text-[#6b7280]');
  rightItems.forEach(el => el.classList.add('opacity-30'));
  leftItems.forEach(el => el.classList.remove('opacity-30'));
});
</script>