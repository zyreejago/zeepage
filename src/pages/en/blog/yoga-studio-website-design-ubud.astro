  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: 'https://zeepage.com' + cover,
  datePublished: '2026-10-24',
  inLanguage: 'en',
  author: {
    '@type': 'Organization',
    name: 'zeepage',
    url: 'https://zeepage.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'zeepage',
    url: 'https://zeepage.com',
