---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HomePage from '../components/HomePage.astro';
import '../styles/global.css';

import id from '../i18n/id.json';
import { daerahList } from '../data/daerah.ts';

const t = id;
const lang = 'id';
const canonical = 'https://zeepage.com/';
const description = 'Jasa pembuatan website di Bali untuk UMKM dan brand: company profile, toko online, dan landing page. Desain modern, cepat, SEO friendly, mulai Rp 799 ribu.';

const areaServed = [
  { "@type": "AdministrativeArea", "name": "Bali" },
  ...daerahList.map((d) => ({ "@type": "Place", "name": d.nama })),
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "zeepage",
      "url": canonical,
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://www.google.com/search?q=site:zeepage.com+{search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
{
      "@type": "Organization",
      "@id": "https://zeepage.com/#organization",
      "name": "zeepage",
      "url": "https://zeepage.com/",
      "logo": "https://zeepage.com/logo.png",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+62 889-8724-4675",
        "email": "zinknot@gmail.com",
        "contactType": "customer service",
        "availableLanguage": ["Indonesian", "English"]
      },
      "sameAs": [
        "https://instagram.com/zeepagecom",
        "https://lynk.id/zeepage",
        "https://tiktok.com/@zeepage",
        "https://wa.me/6288987244675",
        "https://share.google/YuD3Jl2ojzkeZRC68"
      ]
    },
    {
      "@type": ["ProfessionalService", "LocalBusiness"],
      "@id": "https://zeepage.com/#localbusiness",
      "name": "zeepage",
      "description": "Jasa pembuatan website di Bali, melayani seluruh Indonesia. Gratis konsultasi, desain modern, SEO friendly. Cocok untuk company profile, e-commerce, landing page, dan web application.",
      "url": canonical,
      "image": "https://zeepage.com/logo.png",
      "logo": "https://zeepage.com/logo.png",
      "telephone": "+62 889-8724-4675",
      "email": "zinknot@gmail.com",
      "priceRange": "Rp 799k - Rp 1.499k",
      "offers": [
        { "@type": "Offer", "name": "Landing Page", "price": "799000", "priceCurrency": "IDR", "itemOffered": { "@type": "Service", "name": "Pembuatan Landing Page" } },
        { "@type": "Offer", "name": "Website Company Profile", "price": "1499000", "priceCurrency": "IDR", "itemOffered": { "@type": "Service", "name": "Pembuatan Website Company Profile" } }
      ],
      "serviceType": ["Web Development", "Website Design", "SEO"],
      "areaServed": areaServed,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Badung",
        "addressRegion": "Bali",
        "addressCountry": "ID"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "09:00",
        "closes": "18:00"
      },
      "parentOrganization": { "@id": "https://zeepage.com/#organization" },
      "sameAs": [
        "https://wa.me/6288987244675",
        "https://instagram.com/zeepagecom",
        "https://lynk.id/zeepage",
        "https://tiktok.com/@zeepage"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Berapa biaya membuat website di zeepage?", "acceptedAnswer": { "@type": "Answer", "text": "Landing page Rp 799 ribu dan company profile Rp 1.499 ribu, keduanya termasuk domain .com gratis 1 tahun, hosting gratis, SSL gratis, dan support gratis. Biaya tahunan Rp 600 ribu berlaku mulai tahun kedua. Kebutuhan khusus seperti e-commerce dan aplikasi web dihitung setelah konsultasi, selalu dengan penawaran tertulis di awal." } },
        { "@type": "Question", "name": "Berapa lama pengerjaannya?", "acceptedAnswer": { "@type": "Answer", "text": "Landing page selesai dalam 1 sampai 2 minggu. Company profile selesai dalam 2 sampai 4 minggu, tergantung kelengkapan materi dari Anda." } },
        { "@type": "Question", "name": "Apakah bisa revisi?", "acceptedAnswer": { "@type": "Answer", "text": "Bisa. Paket landing page termasuk 2 kali revisi desain dan company profile 3 kali revisi desain." } },
        { "@type": "Question", "name": "Apakah ada perawatan setelah website jadi?", "acceptedAnswer": { "@type": "Answer", "text": "Ada. Landing page termasuk maintenance gratis 30 hari dan company profile gratis 3 bulan. Setelah masa gratis berakhir, perawatan bisa dilanjutkan dengan paket berbayar." } },
        { "@type": "Question", "name": "Saya belum punya logo dan materi, apakah bisa dibantu?", "acceptedAnswer": { "@type": "Answer", "text": "Bisa. Ceritakan dulu bisnis Anda saat konsultasi, kami bantu arahkan kebutuhan logo, foto, dan teksnya agar website tetap bisa jalan." } }
      ]
    }
  ]
};
---

<BaseLayout
  title="zeepage | Jasa Pembuatan Website di Bali"
  description={description}
  lang="id"
  canonical={canonical}
  structuredData={structuredData}

  preloadImage="/demopadel.webp">
  <Navbar t={t.nav} lang={lang} cta={{ primary: t.hero.cta1, secondary: t.hero.cta2, whatsapp: t.cta.whatsapp, whatsappUrl: t.cta.whatsappUrl }} />
  <HomePage lang="id" />
  <Footer t={t.footer} lang={lang} navLinks={t.nav.links} id="footer" />
</BaseLayout>
