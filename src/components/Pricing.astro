---
export interface Props {
  t: {
    badge: string;
    title: string;
    titleHighlight: string;
    subtitle: string;
    plans: {
      name: string;
      price: string;
      target: string;
      features: { text: string; included: boolean }[];
      cta: string;
      popular: boolean;
      customPrice?: boolean;
      whatsapp?: string;
    }[];
  };
  lang: string;
  id: string;
}

const { t, lang, id } = Astro.props;
const popularBadge = lang === 'id' ? 'BEST SELLER' : 'BEST SELLER';
---

<section id={id} class="bg-paper">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-12" data-reveal>
      <div>
        <p class="text-xs sm:text-sm font-bold tracking-[0.22em] uppercase text-brand mb-4">{t.badge}</p>
        <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight">
          {t.title} <em class="font-display italic font-medium text-brand">{t.titleHighlight}</em>
        </h2>
      </div>
      <p class="text-ink/55 max-w-sm leading-relaxed">{t.subtitle}</p>
    </div>

    <div data-reveal-group class="grid lg:grid-cols-3 gap-5 items-stretch max-w-5xl">
      {t.plans.map((plan) => (
        <article class:list={[
          'relative rounded-3xl p-7 flex flex-col',
          plan.popular ? 'bg-brand text-white shadow-2xl shadow-brand/30' : 'bg-white border border-line',
        ]}>
          {plan.popular && (
            <span class="absolute -top-3 left-7 bg-ink text-white text-[11px] font-bold tracking-wider uppercase px-3 py-1 rounded-full">{popularBadge}</span>
          )}
          <h3 class="font-bold text-lg">{plan.name}</h3>
          <p class:list={['mt-4 font-extrabold tracking-tight', plan.customPrice ? 'text-3xl' : 'text-4xl']}>{plan.price}</p>
          <p class:list={['text-sm mt-1.5', plan.popular ? 'text-white/70' : 'text-ink/50']}>{plan.target}</p>
          <ul class="space-y-3 mt-7 mb-8 text-sm">
            {plan.features.map((f) => (
              <li class="flex items-start gap-2.5">
                {f.included ? (
                  <svg class:list={['w-5 h-5 mt-0.5 shrink-0', plan.popular ? 'text-white' : 'text-brand']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                ) : (
                  <svg class:list={['w-5 h-5 mt-0.5 shrink-0', plan.popular ? 'text-white/40' : 'text-ink/25']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                )}
                <span class={!f.included ? (plan.popular ? 'text-white/50 line-through' : 'text-ink/40 line-through') : ''}>{f.text}</span>
              </li>
            ))}
          </ul>
          <a
            href={plan.whatsapp || (lang === 'id' ? '#kontak' : '#contact')}
            target={plan.whatsapp ? '_blank' : undefined}
            rel={plan.whatsapp ? 'noopener noreferrer' : undefined}
            class:list={[
              'mt-auto text-center font-bold px-6 py-3.5 rounded-full transition-colors',
              plan.popular ? 'bg-white text-brand hover:bg-paper' : 'bg-ink text-white hover:bg-brand',
            ]}
          >
            {plan.cta}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
