---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

import id from '../../i18n/id.json';

const t = id;
const lang = 'id';
const canonical = 'https://zeepage.com/blog/';
---

<BaseLayout
  title="Blog | zeepage"
  description="Blog zeepage berisi catatan seputar jasa pembuatan website di Bali, SEO, dan pemasaran digital untuk UMKM. Artikel pertama segera terbit."
  lang="id"
  canonical={canonical}
>
  <Navbar t={t.nav} lang={lang} cta={{ primary: t.hero.cta1, secondary: t.hero.cta2, whatsapp: t.cta.whatsapp, whatsappUrl: t.cta.whatsappUrl }} />

  <main>
    <section class="relative pt-32 sm:pt-40 pb-20 sm:pb-28">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <p class="text-sm font-bold text-brand mb-3" data-reveal>Blog / Jurnal</p>
        <h1 class="text-5xl sm:text-6xl font-extrabold tracking-tight max-w-3xl" data-reveal>
          Catatan dari <em class="font-display italic font-medium text-brand">zeepage.</em>
        </h1>
        <p class="text-ink/60 text-lg leading-relaxed max-w-2xl mt-6" data-reveal>
          Halaman ini rumah baru untuk artikel kami. Artikel pertama sedang disiapkan: tips memilih jasa pembuatan website, dasar SEO lokal untuk bisnis di Bali, dan cara mengubah pengunjung website menjadi pelanggan.
        </p>

        <div class="mt-12 border border-dashed border-ink/20 rounded-3xl px-6 py-12 sm:p-14 text-center bg-white" data-reveal>
          <svg class="mx-auto mb-5 text-brand" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          <p class="text-2xl font-bold tracking-tight">Belum ada artikel di sini.</p>
          <p class="text-ink/55 leading-relaxed max-w-md mx-auto mt-3">Isinya menyusul. Sambil menunggu, Anda bisa melihat layanan kami atau langsung konsultasi gratis soal kebutuhan website bisnis Anda.</p>
          <div class="flex flex-wrap justify-center gap-3 mt-8">
            <a href={t.cta.whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-brand text-white font-bold px-7 py-3 rounded-full hover:bg-branddark transition-colors">Konsultasi Gratis</a>
            <a href="/#layanan" class="inline-flex items-center gap-2 border border-ink/15 font-bold px-7 py-3 rounded-full hover:border-brand hover:text-brand transition-colors">Lihat Layanan</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer t={t.footer} lang={lang} navLinks={t.nav.links} id="footer" />
</BaseLayout>
