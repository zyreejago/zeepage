---
export interface Props {
  avatar: string;
  title: string;
  subtitle: string;
  position: 'top-right' | 'bottom-left';
  rotation: number;
  delay: number;
}

const { avatar, title, subtitle, position, rotation, delay } = Astro.props;
---

<div
  class={`floating-card floating-card--${position}`}
  style={`--rotation: ${rotation}deg; animation-delay: ${delay}s;`}
>
  <div class="floating-card__avatar-wrapper">
    <img src={avatar} alt={title} class="floating-card__avatar" />
  </div>
  <h4 class="floating-card__title">{title}</h4>
  <p class="floating-card__subtitle">{subtitle}</p>
</div>

<style>
  .floating-card {
    position: absolute;
    background: linear-gradient(
      135deg,
      rgba(120, 170, 255, 0.5) 0%,
      rgba(100, 150, 255, 0.35) 100%
    );
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow:
      0 8px 32px rgba(0, 40, 120, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    z-index: 10;
    animation: floatIn 0.8s ease-out both, floatUpDown 4s ease-in-out infinite;
    transform: rotate(var(--rotation, 0deg));
  }

  .floating-card--top-right {
    top: 100px;
    right: 30px;
    width: 150px;
  }

  .floating-card--bottom-left {
    bottom: 120px;
    left: 40px;
    width: 150px;
  }

  .floating-card__avatar-wrapper {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 10px;
    border: 2.5px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .floating-card__avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .floating-card__title {
    font-size: 14px;
    font-weight: 700;
    color: white;
    margin-bottom: 2px;
  }

  .floating-card__subtitle {
    font-size: 11px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.7);
  }

  @keyframes floatIn {
    from {
      opacity: 0;
      transform: rotate(var(--rotation, 0deg)) translateY(30px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: rotate(var(--rotation, 0deg)) translateY(0) scale(1);
    }
  }

  @keyframes floatUpDown {
    0%, 100% {
      transform: rotate(var(--rotation, 0deg)) translateY(0px);
    }
    50% {
      transform: rotate(var(--rotation, 0deg)) translateY(-8px);
    }
  }

  @media (max-width: 768px) {
    .floating-card--top-right {
      top: 70px;
      right: 12px;
      width: 120px;
      padding: 10px 12px;
      border-radius: 14px;
    }

    .floating-card--bottom-left {
      bottom: 30px;
      left: 12px;
      width: 120px;
      padding: 10px 12px;
      border-radius: 14px;
    }

    .floating-card__avatar-wrapper {
      width: 40px;
      height: 40px;
      margin-bottom: 6px;
    }

    .floating-card__title {
      font-size: 11px;
    }

    .floating-card__subtitle {
      font-size: 9px;
    }
  }

  @media (max-width: 480px) {
    .floating-card--top-right {
      top: 50px;
      right: 6px;
      width: 90px;
      padding: 6px 8px;
      border-radius: 10px;
    }

    .floating-card--bottom-left {
      bottom: 20px;
      left: 6px;
      width: 90px;
      padding: 6px 8px;
      border-radius: 10px;
    }

    .floating-card__avatar-wrapper {
      width: 28px;
      height: 28px;
      margin-bottom: 3px;
      border-width: 1.5px;
    }

    .floating-card__title {
      font-size: 9px;
    }

    .floating-card__subtitle {
      font-size: 7px;
    }
  }
</style>
