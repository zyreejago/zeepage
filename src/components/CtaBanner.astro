---
export interface Props {
  t: {
    title: string;
    subtitle: string;
    button: string;
    whatsapp: string;
    whatsappUrl: string;
    faqIntro: string;
    questions: { q: string; a: string }[];
  };
  id: string;
}

const { t, id } = Astro.props;
---

<section id={id} class="bg-paper">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24">
    <div class="max-w-3xl" data-reveal>
      <p class="text-xs sm:text-sm font-bold tracking-[0.22em] uppercase text-brand mb-4">FAQ</p>
      <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">{t.faqIntro}</h2>
    </div>

    <div class="max-w-3xl mt-10" data-reveal>
      {t.questions.map((item, i) => (
        <div class="faq-item border-b border-line">
          <button type="button" class="faq-toggle w-full flex items-center gap-4 py-5 text-left focus:outline-none">
            <span class="font-display italic text-brand/60 w-7 shrink-0">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-bold flex-1">{item.q}</span>
            <svg class="chevron w-5 h-5 text-ink/40 shrink-0 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="faq-answer overflow-hidden transition-all duration-300 ease-in-out" style="max-height: 0;">
            <div class="pb-5 pl-11 pr-4">
              <p class="text-ink/55 text-sm leading-relaxed">{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-brand to-branddark text-white px-6 py-14 sm:p-16 mt-20" data-reveal>
      <div class="relative max-w-2xl">
        <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.05]">{t.title}</h2>
        <p class="text-white/75 leading-relaxed mt-4 max-w-xl">{t.subtitle}</p>
        <div class="flex flex-wrap gap-3 mt-9">
          <a href={t.whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-white text-brand font-bold px-7 py-3.5 rounded-full hover:bg-paper transition-colors">
            {t.button}
          </a>
          <a href="https://instagram.com/zeepagecom" target="_blank" rel="noopener noreferrer" class="border border-white/40 font-bold px-7 py-3.5 rounded-full hover:bg-white/10 transition-colors">
            @zeepagecom
          </a>
        </div>
        <p class="text-white/50 text-sm mt-8">Bali, Indonesia</p>
      </div>
    </div>
  </div>
</section>

<script>
// @ts-nocheck
document.querySelectorAll('.faq-item').forEach((item) => {
  const toggle = item.querySelector('.faq-toggle');
  const answer = item.querySelector('.faq-answer');
  const chevron = item.querySelector('.chevron');
  if (!toggle || !answer) return;
  toggle.addEventListener('click', () => {
    const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';
    document.querySelectorAll('.faq-answer').forEach((a) => { a.style.maxHeight = '0px'; });
    document.querySelectorAll('.faq-item .chevron').forEach((c) => { c.style.transform = ''; });
    if (!isOpen) {
      answer.style.maxHeight = answer.scrollHeight + 'px';
      if (chevron) chevron.style.transform = 'rotate(180deg)';
    }
  });
});
</script>
